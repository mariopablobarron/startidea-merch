generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// F0 — captura de leads y solicitudes de cotización
// ============================================================================

model QuoteRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // contacto
  name    String
  company String?
  email   String
  phone   String?

  // brief
  productHint String?
  productRef  String? // ref MidOcean/Makito si vino de ficha
  quantity    Int?
  deadline    String?
  budget      String?
  message     String

  // estado
  status QuoteStatus @default(NEW)
  source String?
  utm    Json?

  notes QuoteNote[]

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model QuoteNote {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  body      String
  author    String
  request   QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String

  @@index([requestId])
}

enum QuoteStatus {
  NEW
  IN_PROGRESS
  SENT
  WON
  LOST
  ARCHIVED
}

// ============================================================================
// F4 — colaboradores (CEE / talleres locales)
// ============================================================================

model Partner {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  kind        PartnerKind
  city        String?
  region      String?
  description String
  services    String[]
  logoUrl     String?
  active      Boolean     @default(true)
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
}

enum PartnerKind {
  CEE
  LOCAL_BUSINESS
  ARTISAN
}

// ============================================================================
// F1 — Catálogo unificado (MidOcean / Makito)
// ============================================================================

enum SupplierCode {
  midocean
  makito
  cifra
}

model Category {
  id       String     @id @default(cuid())
  slug     String // único por padre (no global) — distintos parents pueden tener "Otros"
  name     String
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  parentId String?
  children Category[] @relation("CategoryTree")
  level    Int        @default(1) // 1, 2, 3 según MidOcean category_levelN
  products Product[]

  // unicidad por path: top-level (parentId NULL) + nested
  @@unique([parentId, slug])
  @@index([parentId])
  @@index([slug])
}

model Product {
  id                       String       @id @default(cuid())
  // identificación
  supplier                 SupplierCode
  supplierRef              String // master_code MidOcean (NUNCA exponer al cliente)
  internalRef              String?      @unique // referencia propia Startidea ("STM-XXXXXX") visible al cliente
  slug                     String       @unique
  name                     String
  brand                    String?
  shortDescription         String?      @db.Text
  longDescription          String?      @db.Text
  // Descripción comercial mejorada por IA (sustituye a la del proveedor en UI cuando existe)
  enhancedShortDescription String?      @db.Text
  enhancedAt               DateTime?
  material                 String?

  // categoría primaria
  category             Category? @relation(fields: [categoryId], references: [id])
  categoryId           String?
  supplierCategoryCode String?

  // dimensiones / peso (en mm y g normalizados)
  weightG  Int?
  lengthMm Int?
  widthMm  Int?
  heightMm Int?

  // imagen principal
  primaryImageUrl String?

  // metadatos
  countryOfOrigin String?
  ecoLabels       String[] @default([])
  tags            String[] @default([])

  // sincronización
  fromPriceCents Int? // cents EUR — "Desde X€" calculado
  active         Boolean  @default(true)
  syncedAt       DateTime @default(now())

  // Hints de marcaje cuando el proveedor NO da estructura completa (caso Cifra).
  // MidOcean usa MarkingPosition + MarkingTechnique + MarkingPriceScale (estructura
  // completa). Cifra solo manda 2 strings en su JSON por producto:
  //   - tgrabacion: técnica (códigos opacos: "A", "A, DIGITAL", "L, TR"…)
  //   - mgrabacion: medida del área ("70x40 mm")
  // Persistimos ambos para que el cotizador admin (V2 público después) pueda
  // resolver tarifa con SupplierMarkingRule.
  markingTechniqueHint String? // ej "A, DIGITAL"
  markingSizeHint      String? // ej "70x40 mm"

  variants             ProductVariant[]
  positions            MarkingPosition[]
  embedding            ProductEmbedding?
  override             ProductOverride?
  slugRedirects        ProductSlugRedirect[] @relation("SlugRedirects")
  mockupRequests       MockupRequest[]
  productMarkingPrices ProductMarkingPrice[]
  view                 ProductView?

  @@unique([supplier, supplierRef])
  @@index([categoryId])
  @@index([active])
  @@index([syncedAt])
}

/// SearchAlias — redirige queries del navbar a una página/categoría
/// concreta. Útil para que «teletrabajo» o «kit verano» lleven
/// directamente al landing/categoría que mejor cubre la intención
/// aunque ningún producto del catálogo se llame así literalmente.
///
/// Gestión desde /admin/insights/search-aliases.
model SearchAlias {
  id          String   @id @default(cuid())
  queryLower  String   @unique // ej. "teletrabajo"
  redirectTo  String // URL relativa: "/catalogo?q=mochila+termo" o "/categoria/eventos"
  description String? // contexto para el admin
  active      Boolean  @default(true)
  hitCount    Int      @default(0) // cuántas veces se activó
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

/// SearchQuery — log de búsquedas del navbar para detectar demanda no
/// cubierta. Si los clientes buscan "mascarilla N95" o "tablet 10
/// pulgadas" y devuelve 0 resultados, son leads de catálogo para añadir.
///
/// Se agregan en /admin/insights y se generan sugerencias automáticas
/// para queries con muchos hits y 0 resultados.
model SearchQuery {
  id           String   @id @default(cuid())
  query        String   @db.Text
  queryLower   String // normalizado para agrupar "Camisa" y "camisa"
  resultsCount Int      @default(0) // 0 = sin resultados (gold mine)
  ip           String?
  ua           String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([queryLower])
  @@index([createdAt(sort: Desc)])
  @@index([resultsCount])
}

/// ProductView — contadores agregados de interacción del cliente con el
/// producto. Una fila por producto, se hace upsert con increment desde
/// /api/track/product-event.
///
/// Útil para:
/// - Top productos visualizados → admin dashboard
/// - Productos populares sin imagen → sugerencias
/// - Engagement por categoría → análisis trends
/// - Conversión catálogo → cart → cotización
model ProductView {
  productId        String   @id
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // contadores acumulados desde lanzamiento
  viewCount        Int      @default(0)
  cartAddCount     Int      @default(0)
  proposalCount    Int      @default(0)
  recommenderCount Int      @default(0)
  // contadores últimos 30 días (rolling window, recalculados por cron)
  view30d          Int      @default(0)
  cartAdd30d       Int      @default(0)
  // fechas
  firstViewedAt    DateTime @default(now())
  lastViewedAt     DateTime @updatedAt
  lastCartAddAt    DateTime?

  @@index([viewCount(sort: Desc)])
  @@index([view30d(sort: Desc)])
  @@index([lastViewedAt(sort: Desc)])
}

/// Tarifa REAL de marcaje por producto extraída del catálogo PDF de Cifra
/// (Catalogo_2026.pdf). Cada producto tiene 4 tramos de cantidad (-500 / 500
/// / 2000 / 5000 para "1 color 1 posición") con su precio unitario.
///
/// Tiene preferencia sobre SupplierMarkingRule (% aproximado) en el helper
/// de cotización: si existe ProductMarkingPrice → se usa; si no → cae al %
/// del SupplierMarkingRule por técnica.
///
/// FULL_COLOR es opcional — sólo ~25 productos en el catálogo lo tienen
/// (escalado distinto: 100/250/500/1000).
model ProductMarkingPrice {
  id          String           @id @default(cuid())
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  mode        MarkingPriceMode
  maxAreaCm   String? // ej "10x4 cm" para FULL_COLOR
  // 4 tramos: minQty + precio unitario en céntimos
  tier1MinQty Int
  tier1Cents  Int
  tier2MinQty Int
  tier2Cents  Int
  tier3MinQty Int
  tier3Cents  Int
  tier4MinQty Int
  tier4Cents  Int
  source      String           @default("cifra-pdf-2026")
  extractedAt DateTime         @default(now())

  @@unique([productId, mode])
  @@index([productId])
}

enum MarkingPriceMode {
  ONE_COLOR
  FULL_COLOR
}

/// Tarifa aproximada de marcaje por técnica para proveedores cuyo API
/// NO devuelve pricelist estructurado (caso Cifra: solo strings sueltos
/// `tgrabacion` + `mgrabacion`).
///
/// Modelo simple: cada técnica suma un % sobre el precio unitario del
/// producto. Útil para cotización pública inmediata; el admin ajusta el
/// presupuesto final tras la consulta a Cifra.
///
/// MidOcean NO usa esta tabla — su tarifa real vive en
/// MarkingTechnique + MarkingPriceScale.
model SupplierMarkingRule {
  id             String       @id @default(cuid())
  supplier       SupplierCode
  // Código corto del proveedor ("A", "B", "DIGITAL"…). Coincide con los
  // tokens dentro de Product.markingTechniqueHint (split por ", ").
  techniqueCode  String
  // Etiqueta legible al cliente ("Tampografía", "Impresión digital")
  techniqueLabel String
  // Porcentaje (entero) que se suma al precio unitario del producto.
  // 15 = +15% del precio unitario por unidad personalizada.
  markupPct      Int
  // Setup fijo opcional (fee único por pedido, EUR cents). Para gastos
  // de cliché/film/láser. Puede ser null si la técnica no aplica setup.
  setupCents     Int?
  active         Boolean      @default(true)
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([supplier, techniqueCode])
  @@index([supplier, active])
}

/// Sesión del agente de voz (ElevenLabs Conversational AI). Cada
/// conversación abierta desde la web queda registrada aquí para:
///   - Tracking de uso / coste (~$0.08/min)
///   - Análisis de qué se pregunta (mejorar prompt / catálogo)
///   - Atribución: ¿llevó a CartQuote? ¿qué productos se cotizaron?
///
/// elevenLabsConversationId: id devuelto por ElevenLabs al iniciar sesión.
/// toolsCalled: histórico de tools que invocó el agente (search, quote, …).
/// resultingCartId: si la sesión acabó creando cotización, FK al CartQuote.
model VoiceSession {
  id                       String     @id @default(cuid())
  elevenLabsConversationId String?    @unique
  visitorAnonId            String? // cookie/sessionStorage id (no PII)
  startedAt                DateTime   @default(now())
  endedAt                  DateTime?
  durationSec              Int?
  estimatedCostCents       Int? // estimated cost in EUR cents
  toolsCalled              Json? // [{tool, args, ok, at}]
  productSlugsDiscussed    String[]   @default([])
  resultingCart            CartQuote? @relation(fields: [resultingCartId], references: [id], onDelete: SetNull)
  resultingCartId          String?
  userAgent                String?
  sourceUrl                String?

  @@index([startedAt(sort: Desc)])
  @@index([resultingCartId])
}

/// Subdivisión interna del CartQuote por proveedor. Un cliente paga 1 cart,
/// pero internamente se divide en N PurchaseOrder (uno por supplier). Cada
/// PO se procesa con su adaptador (MidOcean auto, Makito email manual, …),
/// tiene su propio plazo, tracking y status. El cliente ve "tu pedido viene
/// en N envíos" sin saber qué proveedor hay detrás.
///
/// Permite escalar a 3, 4, N proveedores sin reescribir nada.
model PurchaseOrder {
  id       String       @id @default(cuid())
  cart     CartQuote    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId   String
  supplier SupplierCode

  // Referencia que devuelve el proveedor al confirmar pedido
  supplierOrderRef String?
  status           PurchaseOrderStatus @default(PENDING)

  // Items que pertenecen a este PO (subset del cart)
  items CartQuoteItem[]

  // Snapshot del total cliente de este PO (suma de items)
  totalClientCents Int @default(0)

  // Envío al cliente final
  estimatedDeliveryDate DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  trackingCarrier       String?
  trackingNumber        String?
  trackingUrl           String?

  // Trazabilidad del proceso interno
  placedAt      DateTime?
  errorMessage  String?   @db.Text
  internalNotes String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([supplier])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

enum PurchaseOrderStatus {
  PENDING // creado, sin enviar al proveedor todavía
  PLACED // enviado al proveedor con orderRef confirmado
  IN_PRODUCTION // proveedor confirmó producción
  SHIPPED // proveedor envió al cliente
  DELIVERED // cliente confirmó recibido
  CANCELED // cancelado (cliente o proveedor)
  FAILED // error procesando con proveedor (necesita admin)
}

/// Mini-CRM para outbound manual (LinkedIn, email, eventos). Trackea
/// cada lead desde "lo añadí a la lista" hasta "cerró pedido" o "descartado".
/// No es para reemplazar HubSpot — es para que Mario lleve su pipeline
/// personal sin abrir 3 apps.
model OutboundLead {
  id            String             @id @default(cuid())
  name          String
  company       String?
  role          String? // Marketing Manager, RSC Manager…
  email         String?
  linkedinUrl   String?
  phone         String?
  segment       String? // tech, events, rsc, freelance, etc.
  source        String? // sales-navigator, evento-xxx, referido-fulanito
  status        OutboundLeadStatus @default(NEW)
  lastContactAt DateTime?
  nextActionAt  DateTime? // cuándo tocar al lead de nuevo
  notes         String?            @db.Text
  ownerEmail    String? // admin que lo gestiona
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, nextActionAt])
  @@index([createdAt(sort: Desc)])
}

enum OutboundLeadStatus {
  NEW // lo añadí, sin contactar
  INVITED // mandé conexión LinkedIn
  CONNECTED // aceptó conexión
  MESSAGED // mandé primer mensaje
  REPLIED // me respondió
  MEETING_BOOKED // agendamos llamada/visita
  PROPOSAL_SENT // mandé propuesta cerrada
  WON // cerró pedido (cliente)
  LOST // descartado (no encaja, no responde, dijo que no)
  NURTURING // larga distancia, mantener contacto
}

/// Solicitudes de partners para entrar al programa de afiliados.
/// Pipeline: PENDING → admin revisa → APPROVED (se crea AffiliatePartner)
/// o REJECTED (con motivo opcional). Mantenemos histórico siempre.
model PartnerApplication {
  id                String                   @id @default(cuid())
  name              String
  email             String
  company           String?
  role              String? // ej. "Agencia eventos", "Consultora RSC"
  audience          String? // a quién promocionaría
  message           String?                  @db.Text
  status            PartnerApplicationStatus @default(PENDING)
  reviewedAt        DateTime?
  reviewedBy        String? // email del admin
  rejectionReason   String?
  approvedPartnerId String?                  @unique
  approvedPartner   AffiliatePartner?        @relation(fields: [approvedPartnerId], references: [id], onDelete: SetNull)
  createdAt         DateTime                 @default(now())

  @@index([status])
  @@index([createdAt(sort: Desc)])
}

enum PartnerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Cálculos guardados de la calculadora ROI RSC. Sirve doble propósito:
///   1. Lead capture: cliente deja email para descargar certificado PDF.
///   2. Visibilidad comercial: el admin ve quién está calculando qué tamaño.
///
/// El PDF se regenera on-demand desde estos datos (no se cachea).
model RoiCalculation {
  id                 String   @id @default(cuid())
  email              String
  name               String?
  company            String?
  // Inputs
  employees          Int
  annualBudgetEur    Int // presupuesto anual en €
  substitutionPct    Int // % del actual que migrarías (0-100)
  // Outputs calculados (snapshotted para reproducibilidad del PDF)
  co2SavedKg         Int
  workHoursDignified Int
  ceeProductionPct   Int
  treesEquivalent    Int
  // Tracking
  sourceUrl          String?
  createdAt          DateTime @default(now())

  @@index([email])
  @@index([createdAt(sort: Desc)])
}

/// Idempotencia de webhooks de Stripe. Stripe garantiza "at-least-once"
/// delivery — un mismo evt_xxx puede llegar 2+ veces (ej. nuestro server
/// respondió tarde a la primera entrega). Sin esta tabla, procesar duplicado
/// = duplicar email + duplicar pedido a MidOcean + duplicar referral.
///
/// El webhook intenta `create` antes de procesar. Si la constraint unique
/// salta (P2002), sabemos que el evento ya se procesó → respondemos 200
/// sin hacer nada.
model ProcessedStripeEvent {
  eventId     String   @id // evt_xxx (Stripe event id)
  eventType   String // checkout.session.completed, etc.
  processedAt DateTime @default(now())

  @@index([processedAt(sort: Desc)])
}

/// Histórico de ejecuciones de los crons del sistema. Cada fila es una
/// invocación (programada por el VPS o lanzada manualmente desde admin).
/// Sirve para diagnóstico y auditoría — la página /admin/system/crons lo lee.
model CronRunLog {
  id          String    @id @default(cuid())
  name        String // ej. "backup-db", "post-order-drip"
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  ok          Boolean   @default(false)
  httpStatus  Int?
  durationMs  Int?
  response    String?   @db.Text // primeros ~500 chars del body
  error       String?   @db.Text
  triggeredBy String    @default("cron") // "cron" | "manual:<email>" | "test"

  @@index([name, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
}

/// Lead-magnet: cuando el cliente NO confía en la previsualización automática
/// del mockup y prefiere que el equipo le mande mockup técnico real con
/// medidas exactas y la técnica de marcaje correcta. Promesa: 4h laborables.
model MockupRequest {
  id          String              @id @default(cuid())
  product     Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId   String?
  productSlug String // copia textual del slug en el momento de la solicitud
  positionId  String? // zona elegida (FRONT DO DL, ROUNDSCREEN, etc)
  name        String
  email       String
  company     String?
  phone       String?
  brief       String?             @db.Text
  logoUrl     String? // URL local /uploads/... si subió logo
  status      MockupRequestStatus @default(NEW)
  sourceUrl   String? // página desde donde se solicitó
  notes       String?             @db.Text
  fulfilledAt DateTime?
  fulfilledBy String? // email del admin
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status])
  @@index([productId])
  @@index([createdAt])
}

enum MockupRequestStatus {
  NEW
  IN_PROGRESS
  DELIVERED
  CANCELLED
}

/// Redirects 301 de slugs antiguos (incluían supplier SKU como "-mo9812")
/// hacia el slug actual limpio del producto. Sirve para no romper SEO/links
/// externos al migrar el formato.
model ProductSlugRedirect {
  id        String   @id @default(cuid())
  oldSlug   String   @unique
  product   Product? @relation("SlugRedirects", fields: [productId], references: [id], onDelete: SetNull)
  productId String?
  createdAt DateTime @default(now())

  @@index([productId])
}

/// Override editable desde admin por producto.
/// 1:1 con Product. Si existe row, los campos no-null reemplazan al base.
/// El sync de proveedores NUNCA toca esta tabla.
model ProductOverride {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @unique

  // Overrides del producto base
  customName           String? // sustituye a name
  customDescription    String?  @db.Text // sustituye a longDescription/shortDescription en UI
  customFromPriceCents Int? // sustituye a fromPriceCents (override de margen)
  marginPct            Int? // alternativa: aplicar margen % sobre fromPriceCents base
  extraImages          String[] @default([]) // URLs de imágenes custom (CDN externo o /uploads)

  // Estado de marketing
  featured      Boolean  @default(false) // destacar en home / lista
  hidden        Boolean  @default(false) // ocultar del catálogo público
  marketingTags String[] @default([]) // ej. ["best-seller", "eco", "novedad"]

  // SEO override
  metaTitle       String?
  metaDescription String? @db.Text

  // Notas internas para el equipo
  internalNotes String? @db.Text

  updatedAt DateTime @updatedAt
  updatedBy String? // email del admin

  @@index([featured])
  @@index([hidden])
}

model ProductVariant {
  id             String      @id @default(cuid())
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      String
  sku            String      @unique
  variantId      String? // variant_id MidOcean
  colorName      String?
  colorGroup     String?
  colorHex       String?
  gtin           String?
  size           String?
  // stock más reciente conocido (snapshot)
  stockQty       Int         @default(0)
  stockUpdatedAt DateTime?
  // imagen principal de esta variante
  imageUrl       String?
  images         String[]    @default([])
  // tramos de precio escalado por cantidad (cuando llega pricelist proveedor)
  priceTiers     PriceTier[]

  @@index([productId])
  @@index([sku])
}

// Tramo de precio escalado por cantidad (e.g. 10 uds → 4,89€/ud, 25 uds → 3,12€/ud).
// Origen: pricelist MidOcean / Makito; en su ausencia, defaults internos por categoría.
model PriceTier {
  id             String          @id @default(cuid())
  variant        ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId      String
  minQty         Int // tramo mínimo aplicable
  unitPriceCents Int // precio unitario neto en céntimos EUR
  source         PriceTierSource @default(DEFAULT_ESTIMATE)
  updatedAt      DateTime        @default(now())

  @@unique([variantId, minQty])
  @@index([variantId])
}

enum PriceTierSource {
  MIDOCEAN_PRICELIST
  MAKITO_PRICELIST
  CIFRA_PRICELIST
  DEFAULT_ESTIMATE
  MANUAL_OVERRIDE
}

// Posiciones de marcaje (del printdata)
model MarkingPosition {
  id          String                       @id @default(cuid())
  product     Product                      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  positionId  String // ej. "TOP COMPASS", "TOP BOX"
  maxWidthMm  Float?
  maxHeightMm Float?
  imageUrl    String? // mockup de la zona
  techniques  MarkingTechniqueOnPosition[]

  @@index([productId])
}

// Técnicas de impresión disponibles globalmente con tarifa MidOcean
model MarkingTechnique {
  id               String                       @id @default(cuid())
  code             String                       @unique // "B", "L3", "BP"...
  name             String // legible en español
  description      String? // descripción original del proveedor (EN)
  // Tarifa
  pricingType      PricingType? // NumberOfPositions, AreaRange, etc.
  setupCents       Int? // setup fijo por pedido (cliché/film/láser)
  setupRepeatCents Int? // setup reducido al repetir el mismo diseño
  hasNextColour    Boolean                      @default(false) // true si añade coste por tinta extra
  positions        MarkingTechniqueOnPosition[]
  scales           MarkingPriceScale[]
}

enum PricingType {
  NumberOfPositions
  AreaRange
  Area
  NumberOfColours
  ColourAreaRange
}

// Escalado de precio por cantidad para una técnica + rango opcional de área.
// Una técnica simple (NumberOfPositions) tiene scales con rangeId=null.
// Una técnica AreaRange tiene varios rangeId (A, B, C…) con area_from/to.
model MarkingPriceScale {
  id                  String           @id @default(cuid())
  technique           MarkingTechnique @relation(fields: [techniqueCode], references: [code], onDelete: Cascade)
  techniqueCode       String
  rangeId             String? // "A", "B", "C"… solo para AreaRange / ColourAreaRange
  areaFromCm2         Float? // área mínima del rango (cm²)
  areaToCm2           Float? // área máxima del rango (cm²)
  minQty              Int // tramo mínimo aplicable
  unitCostCents       Int // coste neto por unidad (céntimos EUR)
  nextColourCostCents Int? // coste por tinta extra (si la técnica tiene multicolor)
  updatedAt           DateTime         @default(now())

  @@unique([techniqueCode, rangeId, minQty])
  @@index([techniqueCode])
}

// Manipulaciones del logo (Simple, Medium, Complex…) — coste extra por unidad
// según complejidad del archivo de impresión que mande el cliente.
model PrintManipulation {
  code          String   @id // "A","B","C","D","E","Z"
  description   String // "Simple", "Medium"…
  unitCostCents Int // céntimos EUR por unidad
  updatedAt     DateTime @default(now())
}

// ============================================================================
// Usuarios admin con roles (sustituye al X-Admin-Secret único)
// ============================================================================

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(COMERCIAL)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  @@index([active])
}

enum AdminRole {
  CEO // todo · gestión usuarios · facturación · análisis
  COMERCIAL // cotizaciones, propuestas IA, sin costes ni payments
  FACTURACION // payments, links pago, IVA, sin editar cotizaciones
  OPERACIONES // pedidos producción, tracking, proofs, sin precios cliente
}

// Usuarios cliente — portal /clientes con control completo
model CustomerUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  company      String?
  passwordHash String? // nullable: pueden entrar también con magic link
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  // Magic link login (sin contraseña)
  magicLinkToken     String?   @unique
  magicLinkExpiresAt DateTime?

  @@index([active])
}

// ============================================================================
// API pública para clientes corporativos (key + secret)
// ============================================================================

model ApiKey {
  id         String    @id @default(cuid())
  label      String
  email      String
  company    String?
  // hash del secret (no almaceno el plano)
  keyPrefix  String    @unique // primeros 8 chars del secret para identificar
  secretHash String
  active     Boolean   @default(true)
  scopes     String[]  @default([]) // ["read:catalog", "write:quote"]
  rateLimit  Int       @default(100) // req/h
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  notes      String?   @db.Text

  webhooks WebhookEndpoint[]

  @@index([active])
}

// Webhooks salientes hacia clientes API
model WebhookEndpoint {
  id              String    @id @default(cuid())
  apiKey          ApiKey?   @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  apiKeyId        String?
  url             String
  secret          String // firma HMAC-SHA256 del payload
  events          String[]  @default([]) // quote.status.changed, payment.completed, proof.status.changed
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  lastDeliveredAt DateTime?
  lastFailedAt    DateTime?

  deliveries WebhookDelivery[]

  @@index([apiKeyId])
  @@index([active])
}

model WebhookDelivery {
  id         String          @id @default(cuid())
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  endpointId String

  event              String
  payload            Json
  status             DeliveryStatus @default(PENDING)
  attempts           Int            @default(0)
  lastResponseStatus Int?
  lastError          String?        @db.Text
  createdAt          DateTime       @default(now())
  deliveredAt        DateTime?
  nextRetryAt        DateTime?

  @@index([endpointId])
  @@index([status, nextRetryAt])
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  ABANDONED
}

// Newsletter privada — alta voluntaria + drip emails post-pedido
model NewsletterSubscriber {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String?
  company          String?
  phone            String?
  source           String? // home-footer, blog, recommend-after, import:<id>, manual, ...
  locale           String            @default("es")
  // Tags libres usados como "listas" para segmentar broadcasts.
  // Convención: "lista-YYYY-MM-descripcion" + tags semánticos (cliente, partner, evento, …)
  tags             String[]          @default([])
  // Metadata libre por subscriber (columnas extra del Excel, ej. ciudad, sector, presupuesto…)
  meta             Json?
  // Si vino de un import en bloque, FK al batch para "ver/deshacer/re-enviar lista"
  importBatch      NewsletterImport? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  importBatchId    String?
  optedInAt        DateTime          @default(now())
  unsubscribedAt   DateTime?
  unsubscribeToken String            @unique @default(cuid())
  lastSentAt       DateTime?
  totalSent        Int               @default(0)

  @@index([unsubscribedAt])
  @@index([importBatchId])
  @@index([tags], type: Gin)
}

model EmailDripSent {
  id     String   @id @default(cuid())
  cartId String
  step   Int // 0, 14, 45
  sentAt DateTime @default(now())

  @@unique([cartId, step])
  @@index([cartId])
}

// Programa de afiliados (distinto de Partner = CEE definido al principio)
model AffiliatePartner {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  email             String
  company           String?
  // Comisión por defecto que cobra el afiliado (se paga aparte, transferencia).
  // Por cupón se puede sobrescribir en Coupon.commissionPctOverride.
  commissionPct     Int      @default(10)
  // Crédito por defecto que acumula el afiliado para sus propias compras
  // (se descuenta del próximo pedido del propio afiliado). Override en
  // Coupon.creditPctOverride.
  creditPct         Int      @default(0)
  active            Boolean  @default(true)
  // Totales históricos legacy (se mantienen para compat).
  totalEarnedCents  Int      @default(0)
  totalPaidOutCents Int      @default(0)
  notes             String?  @db.Text
  createdAt         DateTime @default(now())

  referrals   Referral[]
  application PartnerApplication?
  coupons     Coupon[]
  ledger      AffiliateLedgerEntry[]

  @@index([active])
}

// Ledger de movimientos de comisión y crédito por afiliado.
// Modelo append-only: cada movimiento (ganancia, pago, uso de crédito,
// ajuste manual) crea una entry nueva. El saldo actual = SUM(amountCents)
// por kind. Permite auditoría completa.
model AffiliateLedgerEntry {
  id          String              @id @default(cuid())
  partner     AffiliatePartner    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId   String
  kind        AffiliateLedgerKind
  // Importe en céntimos. SIGNO IMPORTA:
  //   COMMISSION    → POSITIVO (gana)
  //   CREDIT        → POSITIVO (acumula)
  //   PAYOUT        → NEGATIVO (admin paga comisión devengada)
  //   CREDIT_USED   → NEGATIVO (afiliado gasta crédito en su pedido)
  //   ADJUSTMENT    → cualquier signo (ajuste manual con nota)
  amountCents Int
  // Refs opcionales para trazabilidad
  cartId      String?
  couponId    String?
  // Quién lo hizo (admin email para PAYOUT/ADJUSTMENT, sistema para auto)
  createdBy   String?
  note        String?             @db.Text
  createdAt   DateTime            @default(now())

  @@index([partnerId, kind])
  @@index([createdAt(sort: Desc)])
}

enum AffiliateLedgerKind {
  COMMISSION // +cents · cupón canjeado → comisión devengada
  CREDIT // +cents · cupón canjeado → crédito al afiliado
  PAYOUT // -cents · admin paga comisión vía transferencia/factura
  CREDIT_USED // -cents · afiliado usa su crédito en su propio pedido
  ADJUSTMENT // ± cents · ajuste manual (corrección, bonus, etc)
}

model Referral {
  id              String           @id @default(cuid())
  partner         AffiliatePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId       String
  cartId          String           @unique
  status          ReferralStatus   @default(LEAD)
  baseAmountCents Int              @default(0) // cuánto se cobró que computa para comisión
  commissionCents Int              @default(0)
  paidOutAt       DateTime?
  createdAt       DateTime         @default(now())

  @@index([partnerId])
  @@index([status])
}

enum ReferralStatus {
  LEAD // cart creado, aún sin pagar
  EARNED // cart pagado, comisión devengada pero no liquidada
  PAID_OUT // pagada al partner
  REFUSED // partner cancelado / fraude
}

// Embeddings semánticos para búsqueda inteligente
model ProductEmbedding {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String   @unique
  vector    Float[]
  model     String
  createdAt DateTime @default(now())

  @@index([productId])
}

// Cupones / descuentos comerciales
model Coupon {
  id           String     @id @default(cuid())
  code         String     @unique
  label        String
  kind         CouponKind
  percentValue Int? // 1-100 (si kind = PERCENT)
  fixedCents   Int? // descuento fijo en céntimos (si kind = FIXED)

  minTotalCents Int? // total mínimo del carrito para que aplique
  maxUses       Int? // máximo nº de usos (null = ilimitado)
  usedCount     Int  @default(0)

  validFrom  DateTime  @default(now())
  validUntil DateTime?

  // Vínculo opcional a afiliado: si se canjea este cupón, se generan
  // entries COMMISSION + CREDIT en AffiliateLedger automáticamente.
  affiliate             AffiliatePartner? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  affiliateId           String?
  // Si null, se usa el commissionPct/creditPct por defecto del partner.
  // Si está, overridea (útil para cupones especiales con condiciones distintas).
  commissionPctOverride Int?
  creditPctOverride     Int?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  notes     String?  @db.Text

  redemptions CouponRedemption[]

  @@index([active])
  @@index([affiliateId])
}

enum CouponKind {
  PERCENT
  FIXED
}

model CouponRedemption {
  id            String    @id @default(cuid())
  coupon        Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  couponId      String
  cart          CartQuote @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId        String    @unique
  discountCents Int
  appliedAt     DateTime  @default(now())

  @@index([couponId])
}

// Reviews post-pedido (NPS + comentario verificado)
model Review {
  id     String    @id @default(cuid())
  cart   CartQuote @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId String

  token       String    @unique @default(cuid())
  invitedAt   DateTime  @default(now())
  submittedAt DateTime?

  npsScore      Int? // 0-10
  comment       String? @db.Text
  authorName    String?
  authorCompany String?

  approved Boolean @default(false)
  isPublic Boolean @default(true)

  @@index([cartId])
  @@index([approved, submittedAt])
}

// ============================================================================
// Notificaciones push para el equipo admin (Web Push API + VAPID)
// ============================================================================

model PushSubscription {
  id         String    @id @default(cuid())
  endpoint   String    @unique
  p256dh     String
  auth       String
  label      String? // descripción opcional (ej. "Mario · iPhone 15")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

// ============================================================================
// Eventos de analítica (custom, complementan a Umami)
// ============================================================================

model AnalyticsEvent {
  id          String   @id @default(cuid())
  type        String // viewProduct, addToCart, recommend, payClick, payComplete…
  path        String?
  productSlug String?
  payload     Json?
  sessionId   String? // anónimo, generado client-side
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
  @@index([productSlug])
  @@index([sessionId])
}

// ============================================================================
// F2 — Cesta de cotización (multi-producto con marcaje calculado)
// ============================================================================

model CartQuote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // contacto
  name    String
  company String?
  email   String
  phone   String?

  // dirección de envío (opcional, se completa en admin)
  shippingAddress    String?
  shippingPostalCode String?
  shippingCity       String?
  shippingCountry    String? @default("ES")
  vatNumber          String?

  // brief libre para complementar
  message  String?
  deadline String?
  source   String? // landing, ficha-cotizar, etc
  utm      Json?

  // estado
  status              CartQuoteStatus @default(NEW)
  // notas internas y total estimado para que el admin no recalcule
  internalNotes       String?         @db.Text
  estimatedTotalCents Int?

  // integración MidOcean
  midoceanOrderId          String?   @unique
  midoceanCustomerOrderRef String?
  midoceanOrderStatus      String?
  midoceanOrderPayload     Json? // snapshot del payload enviado
  midoceanOrderResponse    Json? // respuesta de MidOcean
  confirmedAt              DateTime?
  orderedAt                DateTime?

  // pago online (Sprint 8)
  acceptedTotalCents Int? // total final negociado por el admin
  depositPercent     Int? // % de depósito a cobrar (50, 100…)
  paymentLinkToken   String?   @unique // token público del enlace de pago
  paymentLinkSentAt  DateTime?

  // Dashboard cliente: token público para ver SUS pedidos e impacto
  customerToken String? @unique

  items          CartQuoteItem[]
  proofs         OrderProof[]
  trackings      OrderTracking[]
  payments       Payment[]
  reviews        Review[]
  redemption     CouponRedemption?
  voiceSessions  VoiceSession[]
  purchaseOrders PurchaseOrder[]

  // Carritos abandonados — sistema de recuperación con recordatorios
  reminderSentAt DateTime? // última vez que se envió recordatorio (manual o auto)
  reminderCount  Int       @default(0) // total de recordatorios enviados
  recoveredAt    DateTime? // cuándo el cliente volvió tras recordatorio

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@index([reminderSentAt])
}

enum CartQuoteStatus {
  NEW
  IN_PROGRESS
  SENT
  CONFIRMED
  ORDERED
  ARCHIVED
}

model CartQuoteItem {
  id     String    @id @default(cuid())
  cart   CartQuote @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId String

  // referencia al producto en el momento de añadir
  productSlug     String
  productRef      String
  productName     String
  primaryImageUrl String?

  // configuración elegida por el cliente
  quantity   Int
  variantSku String? // si elige una variante específica
  colorName  String?

  // marcaje
  markingTechniqueCode String?
  markingTechniqueName String?
  markingPositionId    String?
  markingColours       Int?
  markingComplexity    String? // A,B,C,D,E,Z

  // snapshot del precio cliente calculado en el momento (céntimos EUR)
  unitPriceClientCents Int?
  totalClientCents     Int?

  // Logo del cliente subido (URL relativa /files/customer-logos/...).
  // Mario lo descarga para enviarlo a MidOcean al producir.
  customerLogoUrl      String?
  customerLogoFilename String?
  customerLogoSize     Int? // bytes

  notes String?

  // Multi-marcaje (textil con bordado pecho + serigrafía espalda + láser manga…).
  // Si no hay markings, los campos planos arriba (markingTechniqueCode/PositionId/
  // Colours) son la única marca. Si hay markings[], el primer elemento es
  // espejo de los campos planos y los siguientes son marcas adicionales.
  // Mantenemos los campos planos durante la transición para no romper queries
  // existentes (drips, dashboard, midocean-auto-order legacy).
  markings CartQuoteItemMarking[]

  // PurchaseOrder al que pertenece este item (asignado en el split tras pago).
  // Null mientras el cart no ha sido pagado o no se ha hecho split todavía.
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  purchaseOrderId String?

  @@index([cartId])
  @@index([purchaseOrderId])
}

/// Marca adicional de un CartQuoteItem (textil con pecho + manga + espalda).
/// Permite N personalizaciones por ítem, cada una con su técnica/colores/coste.
/// MidOcean acepta exactamente esto en su array `printing_positions[]`.
model CartQuoteItemMarking {
  id     String        @id @default(cuid())
  item   CartQuoteItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId String

  positionId       String // ej. "FRONT DO DL", "BACK", "SLEEVE_R"
  positionLabel    String? // ej. "Frontal", "Espalda" (snapshot al añadir)
  techniqueCode    String // ej. "S1" serigrafía, "L1" láser, "E1" bordado
  techniqueName    String? // snapshot human-readable
  numberOfColors   Int     @default(1)
  manipulationCode String? // S/M/L/X (rango de cantidad MidOcean)

  // Coste snapshot del momento (céntimos EUR)
  setupCostCents Int? // coste fijo de preparación de esta marca
  unitCostCents  Int? // coste por unidad de esta marca

  notes String? // ej. "logo claim mismo color que bordado"
  order Int     @default(0) // orden visual

  @@index([itemId, order])
}

// ============================================================================
// F2 — Pasarela de proofs (mockups de marcaje a aprobar por cliente)
// ============================================================================

model OrderProof {
  id     String    @id @default(cuid())
  cart   CartQuote @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId String

  // token único para link público de aprobación (sin login)
  token  String      @unique @default(cuid())
  status ProofStatus @default(PENDING)

  // origen del proof
  midoceanProofId String? // si viene de MidOcean
  productSlug     String? // a qué producto/item del cart corresponde
  artworkUrl      String? // imagen/PDF del mockup
  notes           String? @db.Text

  createdAt       DateTime  @default(now())
  decidedAt       DateTime?
  decidedBy       String? // email del cliente que decidió
  rejectionReason String?   @db.Text

  @@index([cartId])
  @@index([token])
  @@index([status])
}

enum ProofStatus {
  PENDING // esperando decisión cliente
  APPROVED // cliente aprobó
  REJECTED // cliente rechazó
  REVISION // cliente subió artwork nuevo
  EXPIRED // pasó el plazo
}

// ============================================================================
// F2 — Pagos online vía Stripe (depósito o pago completo de cotización cerrada)
// ============================================================================

model Payment {
  id     String    @id @default(cuid())
  cart   CartQuote @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId String

  amountCents Int // importe en céntimos EUR
  currency    String        @default("EUR")
  status      PaymentStatus @default(PENDING)
  kind        PaymentKind   @default(DEPOSIT)

  // Stripe metadata
  stripeMode            String? // "test" | "live"
  stripeSessionId       String? @unique
  stripePaymentIntentId String? @unique
  stripeReceiptUrl      String?

  createdAt     DateTime  @default(now())
  paidAt        DateTime?
  refundedAt    DateTime?
  failureReason String?

  // Factura
  invoiceNumber   String?   @unique // formato 2026-0001 (YYYY-NNNN)
  invoiceIssuedAt DateTime?

  @@index([cartId])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
}

enum PaymentKind {
  DEPOSIT // pago de depósito (típicamente 50%)
  FULL // pago total
  BALANCE // pago final (resto tras depósito)
}

// Snapshot del estado del pedido cada vez que consultamos tracking
model OrderTracking {
  id           String    @id @default(cuid())
  cart         CartQuote @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId       String
  fetchedAt    DateTime  @default(now())
  status       String? // estado MidOcean
  trackingCode String?
  carrier      String?
  carrierUrl   String?
  rawJson      Json?

  @@index([cartId])
}

// Snapshot de la última versión de la tarifa de marcaje aplicada
model MarkingPricelistSync {
  id              String       @id @default(cuid())
  supplier        SupplierCode @unique
  validFrom       DateTime
  validUntil      DateTime?
  currency        String       @default("EUR")
  fetchedAt       DateTime     @default(now())
  techniquesCount Int          @default(0)
  scalesCount     Int          @default(0)
}

model MarkingTechniqueOnPosition {
  position    MarkingPosition  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  positionId  String
  technique   MarkingTechnique @relation(fields: [techniqueId], references: [id], onDelete: Cascade)
  techniqueId String
  isDefault   Boolean          @default(false)
  maxColors   Int?

  @@id([positionId, techniqueId])
}

/// Consultas al recomendador IA — registramos cada brief para entender
/// qué pide la gente, descubrir gaps de catálogo y mejorar el prompt.
model RecommenderQuery {
  id                 String   @id @default(cuid())
  brief              String   @db.Text
  budget             Int? // €/total declarado por el cliente
  quantity           Int? // unidades declaradas
  ecoOnly            Boolean  @default(false)
  needsClarification Boolean? // pidió aclaración o devolvió recomendación directa
  fallback           Boolean  @default(false) // true si hubo error parseando JSON
  recommendedSlugs   String[] @default([]) // slugs devueltos al cliente
  summary            String?  @db.Text // resumen del modelo
  modelUsed          String? // ej anthropic/claude-sonnet-4.5
  promptTokens       Int?
  completionTokens   Int?
  ip                 String? // primera IP (proxy headers)
  ua                 String?  @db.Text // user agent
  // Modo de respuesta: "recommend" (cards) o "quote" (cotización multi-item).
  mode               String?
  // Items de cotización enriquecidos con precio. Solo presente en mode=quote.
  // Estructura: [{ description, product:{slug,name,ref}, quantity, sizes?,
  //   technique, unitPriceCents, markingPerUnitCents, markingSetupCents,
  //   totalCents, priceSource, notFound, searchedAs, rationale }]
  quoteItems         Json?
  // Total general estimado (suma de totalCents de quoteItems).
  quoteTotalCents    Int?
  createdAt          DateTime @default(now())

  proposals          Proposal[]

  @@index([createdAt])
  @@index([fallback])
  @@index([needsClarification])
  @@index([mode])
}

/// Proposal — propuesta de cotización enviada por email + PDF.
///
/// Se genera desde el recomendador cuando un visitante introduce su email
/// para recibir la propuesta formal. Contiene los mismos quoteItems que
/// RecommenderQuery (snapshot inmutable de la cotización en el momento
/// del envío) y los totales ya con IVA calculado.
///
/// El PDF se regenera on-the-fly desde quoteItems — no se almacena binario.
/// Acceso al PDF protegido por HMAC token en URL pública.
model Proposal {
  id                 String   @id @default(cuid())
  // Numeración secuencial humana: PROP-YYYY-NNNN (4 dígitos por año).
  // Generada vía advisory lock en createProposal() para evitar colisiones.
  proposalNumber     String   @unique
  email              String
  name               String? // opcional, capturado si el cliente lo da
  company            String? // opcional, capturado si el cliente lo da
  // Snapshot del array quoteItems (mismo shape que RecommenderQuery).
  quoteItems         Json
  subtotalCents      Int // suma de totalCents de items (sin IVA)
  ivaCents           Int // 21% del subtotal
  totalCents         Int // subtotal + iva
  recommenderQueryId String? // FK opcional — origen del brief
  recommenderQuery   RecommenderQuery? @relation(fields: [recommenderQueryId], references: [id], onDelete: SetNull)
  // Status: sent | opened | accepted | rejected
  status             String   @default("sent")
  sentAt             DateTime @default(now())
  openedAt           DateTime? // primera vez que se descargó el PDF
  acceptedAt         DateTime? // si el cliente aceptó y pidió cotización formal
  ip                 String?
  ua                 String?  @db.Text
  resendId           String? // ID del email Resend (para tracking)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([email])
  @@index([sentAt])
  @@index([status])
  @@index([recommenderQueryId])
}

/// MediaAsset — mapeo opaco hash→originalUrl para que el HTML público
/// no exponga el host del CDN proveedor en URLs ni en query strings.
///
/// hash = SHA1(originalUrl) truncado a 16 chars base32 (sin caracteres
/// ambiguos). Determinístico → mismas URLs siempre el mismo hash.
///
/// Endpoint /api/m/[hash] busca aquí, hace fetch a originalUrl y devuelve
/// la imagen. El cliente solo ve /api/m/Q2X9F7K3M2P5R8N4 — sin pista
/// del proveedor.
model MediaAsset {
  hash        String   @id // 16 chars base32 (no 0/O/1/I/L)
  originalUrl String   @unique
  kind        String? // "product-primary" | "product-variant" | "marking-position" | "override-extra"
  createdAt   DateTime @default(now())

  @@index([originalUrl])
}

/// SEO override por página, editable desde admin sin tocar código.
/// Path como id ("/" para home, "/catalogo" para listado, "/sobre", etc.).
/// Si no hay row para un path, las páginas usan sus defaults hardcoded.
///
/// Para fichas de producto NO usar este modelo — usar ProductOverride.metaTitle
/// y ProductOverride.metaDescription que ya existen.
model PageSeo {
  path        String   @id // "/", "/catalogo", "/sobre", "/recomendador"
  title       String? // <title> y og:title
  description String?  @db.Text // <meta description> y og:description
  ogImage     String? // URL absoluta o /public path
  robots      String? // ej "noindex,follow" si quieres
  schemaJson  Json? // schema.org adicional libre (Organization, Service…)
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

/// Configuración del cotizador — singleton (un único registro id="default").
/// Permite a admin editar textos, campos requeridos, plazos, métodos de
/// pago aceptados y plantilla de respuesta sin tocar código.
model QuoteSettings {
  id                   String   @id @default("default")
  heroTitle            String   @default("Cuéntanos qué necesitas.")
  heroSubtitle         String   @default("Te respondemos en 24h.")
  heroBullets          String[] @default([])
  responseHours        Int      @default(24)
  requireCompany       Boolean  @default(false)
  requirePhone         Boolean  @default(false)
  requireDeadline      Boolean  @default(false)
  showBudgetField      Boolean  @default(true)
  deadlineOptions      String[] @default([])
  paymentMethods       String[] @default([])
  successTitle         String   @default("Recibido. Ya estamos en ello.")
  successMessage       String   @default("Te respondemos por email en menos de {hours} horas laborables con cotización cerrada.")
  autoReplyEnabled     Boolean  @default(true)
  autoReplySubject     String   @default("Recibimos tu solicitud · TodoMerchandising")
  autoReplyHtml        String   @default("") @db.Text
  internalNotifyEmails String[] @default([])
  showOnHome           Boolean  @default(true)
  updatedAt            DateTime @updatedAt
  updatedBy            String?
}

/// Lead Magnet — recurso descargable (PDF/guía/tool) que captura email
/// del visitante a cambio de la descarga. Cierra funnel de tráfico frío
/// del blog/SEO sin necesidad de Ads.
///
/// El visitante introduce email + nombre + (opcional) empresa, se le envía
/// link de descarga y se añade automáticamente a NewsletterSubscriber.
model LeadMagnet {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  description   String?        @db.Text
  fileUrl       String // URL absoluta del PDF/recurso
  heroUrl       String? // imagen mock de portada
  category      String? // "guía", "plantilla", "checklist", "case-study"
  tags          String[]       @default([])
  active        Boolean        @default(true)
  featured      Boolean        @default(false)
  downloadCount Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdBy     String?
  downloads     LeadDownload[]

  @@index([active, featured])
}

/// Cada descarga es un evento separado con tracking UTM completo
/// para atribución en /admin/analytics/attribution.
model LeadDownload {
  id           String     @id @default(cuid())
  magnet       LeadMagnet @relation(fields: [magnetId], references: [id], onDelete: Cascade)
  magnetId     String
  email        String
  name         String?
  company      String?
  source       String? // utm_source
  medium       String? // utm_medium
  campaign     String? // utm_campaign
  referer      String?
  ipHash       String? // hash IP para anti-spam, no PII real
  downloadedAt DateTime   @default(now())

  @@index([magnetId])
  @@index([email])
  @@index([downloadedAt])
}

/// Gasto de marketing por canal/mes — input manual o pull de APIs (Meta/Google/LinkedIn)
/// para calcular ROAS = revenue (Payment.PAID por UTM) / spend.
model MarketingSpend {
  id          String   @id @default(cuid())
  // Periodo (siempre primer día del mes para agregación mensual)
  month       DateTime @db.Date
  // Fuente del tráfico (utm_source). Ej: google, meta, linkedin, organic, direct
  source      String
  // Medio (utm_medium). Ej: cpc, social, email, organic, referral
  medium      String
  // Campaña (utm_campaign). Ej: black-friday-2026, retargeting-warm
  campaign    String?
  // Coste en céntimos EUR
  spendCents  Int
  // Métricas agregadas opcionales (impressions, clicks, conversions)
  impressions Int?
  clicks      Int?
  conversions Int?
  // Notas opcionales del admin
  notes       String?  @db.Text
  // Origen del registro (manual, meta_api, google_api, linkedin_api, metricool)
  origin      String   @default("manual")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  @@unique([month, source, medium, campaign])
  @@index([month])
  @@index([source])
}

/// Post de blog SEO — generado por IA o redactado manualmente.
/// Long-form (1500-2500 palabras) con schema.org Article + FAQPage.
/// Tracking de posiciones con Google Search Console (futuro).
model BlogPost {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  excerpt         String?        @db.Text
  bodyMd          String         @db.Text // Markdown source
  heroUrl         String?
  metaTitle       String?
  metaDescription String?        @db.Text
  keywordTarget   String? // keyword principal SEO
  intent          BlogIntent     @default(INFORMATIONAL)
  schemaJson      Json? // schema.org adicional (FAQPage, HowTo…)
  tags            String[]       @default([])
  status          BlogPostStatus @default(DRAFT)
  publishedAt     DateTime?
  metrics         Json? // GSC clicks/impressions/avgPosition
  author          String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdBy       String?

  @@index([status, publishedAt])
  @@index([slug])
}

enum BlogIntent {
  INFORMATIONAL // "qué es", "cómo elegir", "guía"
  TRANSACTIONAL // "comprar", "precios", "proveedor"
  NAVIGATIONAL // "TodoMerchandising opiniones"
  COMMERCIAL // "mejor merchandising", "comparativa"
}

enum BlogPostStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

/// Configuración de integraciones externas (Metricool, Meta, Google, LinkedIn).
/// Guardamos tokens y account IDs aquí en lugar de .env para que el admin
/// pueda editarlos sin redeploy y rotarlos sin tocar infra. Solo CEO accede.
model IntegrationConfig {
  provider   IntegrationProvider @id // un único registro por provider
  enabled    Boolean             @default(false)
  config     Json // {apiKey, blogId, accounts: {IG: "123", LINKEDIN: "456"}}
  lastTestAt DateTime? // último test de conexión
  lastTestOk Boolean? // resultado test
  lastError  String?             @db.Text
  updatedAt  DateTime            @updatedAt
  updatedBy  String?
}

enum IntegrationProvider {
  METRICOOL
  MAGNIFIC // IA imágenes: upscaler, remove-bg, mystic, relight, expand
  REPLICATE // IA imágenes pay-per-use: real-esrgan, flux, rembg, etc.
  META_ADS
  GOOGLE_ADS
  LINKEDIN_ADS
  RESEND // ya usado para emails (placeholder por unificación)
  STRIPE // ya usado (placeholder)
}

/// Tareas Replicate (upscale, flux, remove-bg, etc). Mismo patrón que
/// MagnificTask. La diferencia es el provider y los modelos disponibles.
model ReplicateTask {
  id                 String   @id @default(cuid())
  type               String // "upscale" | "generate" | "remove-bg"
  status             String // "queued" | "processing" | "ready" | "failed"
  model              String // ej "philz1337x/clarity-upscaler"
  inputUrl           String?  @db.Text
  outputUrl          String?  @db.Text // URL local persistida (tras descarga)
  remotePredictionId String?
  prompt             String?  @db.Text
  params             Json?
  error              String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          String?

  @@index([type, status])
  @@index([createdAt])
}

/// Tareas Magnific (upscale, remove-bg, mystic, relight, expand). Persistimos
/// historial por dos motivos: (1) tracking de coste y uso por usuario,
/// (2) poll a Magnific async sin perder el task_id si se cierra la pestaña.
model MagnificTask {
  id           String   @id @default(cuid())
  type         String // "upscale" | "remove-bg" | "mystic" | "relight" | "expand" | "style-transfer"
  status       String // "queued" | "processing" | "ready" | "failed"
  inputUrl     String?  @db.Text // URL imagen origen (no para mystic)
  outputUrl    String?  @db.Text // URL imagen final (cuando ready)
  previewUrl   String?  @db.Text // versión preview (algunos endpoints la dan)
  remoteTaskId String? // task_id devuelto por Magnific (para polling)
  prompt       String?  @db.Text // para mystic
  params       Json? // params de la request (scale, resolution, aspect_ratio, etc)
  error        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String? // email del admin que lanzó la task

  @@index([type, status])
  @@index([createdAt])
}

/// Campaña de marketing — agrupa piezas de contenido + ads bajo un objetivo
/// común. Una campaña típica: "Black Friday 2026 — 25% sobre textil",
/// "Lanzamiento línea eco", "Captación RRHH". UTM auto único por campaña.
model Campaign {
  id           String            @id @default(cuid())
  name         String
  objective    CampaignObjective @default(LEADS)
  channels     String[] // ["meta", "google", "linkedin", "ig", "email"]
  budgetCents  Int?
  startsAt     DateTime
  endsAt       DateTime?
  status       CampaignStatus    @default(PLANNED)
  utmCampaign  String            @unique // slug auto: "black-friday-2026"
  adAccountIds Json? // {meta: "act_xxx", google: "123-456-7890"}
  pieces       ContentPiece[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  createdBy    String?

  @@index([status])
  @@index([startsAt])
}

enum CampaignObjective {
  LEADS // captar formularios / cotizaciones
  CONVERSIONS // pago directo
  TRAFFIC // tráfico a landing
  AWARENESS // alcance / branding
  RETENTION // upsell / cross-sell a clientes actuales
}

enum CampaignStatus {
  PLANNED
  ACTIVE
  PAUSED
  ENDED
  ARCHIVED
}

/// Pieza individual de contenido. Una campaña tiene N piezas.
/// Workflow: DRAFT (admin redacta) → REVIEW (espera aprobación) →
/// APPROVED (lista para schedule) → SCHEDULED (con fecha futura) →
/// PUBLISHED (enviada al canal externo) | FAILED (error al publicar).
model ContentPiece {
  id      String         @id @default(cuid())
  type    ContentType
  channel ContentChannel
  status  ContentStatus  @default(DRAFT)

  // Contenido editable
  title          String? // título interno para identificar la pieza
  copy           String   @db.Text
  copyVariations Json? // alternativas IA: [{ id, text, score }]
  hashtags       String[] @default([])
  mentions       String[] @default([])

  // Creatividad
  creativeUrl   String? // URL PNG/MP4 final renderizado
  creativeBrief String? @db.Text // brief para regenerar

  // Vinculación con producto / campaña
  productSlug String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId  String?

  // Programación
  scheduledAt     DateTime?
  publishedAt     DateTime?
  channelResponse Json? // {externalId, externalUrl, postedAt}

  // Tracking
  utmContent String? // identificador único para atribución
  metrics    ContentMetric[]

  // Auditoría
  createdBy  String?
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([channel])
  @@index([scheduledAt])
  @@index([campaignId])
}

enum ContentType {
  POST // post estático (IG feed, FB, LinkedIn)
  STORY // 9:16 vertical (IG/FB stories)
  REEL // video corto vertical (IG Reels, TikTok, YT Shorts)
  CARRUSEL // carrusel multi-imagen
  EMAIL // pieza de email broadcast
  AD // creatividad de anuncio pagado
  BLOG // artículo SEO largo
  LANDING // landing page de campaña
}

enum ContentChannel {
  IG // Instagram
  FB // Facebook
  LINKEDIN
  X // Twitter/X
  TIKTOK
  YOUTUBE
  PINTEREST
  EMAIL
  WEB // landing propia
  GOOGLE_ADS
  META_ADS
  LINKEDIN_ADS
}

enum ContentStatus {
  DRAFT
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
  ARCHIVED
}

model ContentMetric {
  id          String       @id @default(cuid())
  piece       ContentPiece @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  pieceId     String
  day         DateTime     @db.Date
  impressions Int          @default(0)
  reach       Int          @default(0)
  engagements Int          @default(0)
  clicks      Int          @default(0)
  conversions Int          @default(0)
  spendCents  Int          @default(0)
  source      String // "metricool", "meta", "google", "linkedin", "internal"
  raw         Json?

  @@unique([pieceId, day, source])
  @@index([day])
}

/// Galería "Trabajos realizados" — fotos de pedidos reales con logo aplicado.
/// Trust signal B2B fundamental (todomerch.com lo destaca con su propia
/// página y un grid en home). Editable desde admin con orden manual y
/// link al cliente / al producto.
model PortfolioItem {
  id          String   @id @default(cuid())
  imageUrl    String // URL absoluta o /uploads/
  title       String // ej "200 sudaderas para Acme Corp"
  description String?  @db.Text // detalle opcional (técnica, cantidad, sector)
  clientName  String? // nombre del cliente público
  productSlug String? // link a /catalogo/[slug] si aplica
  sector      String? // tag: "eventos", "rrhh", "marketing", etc.
  featured    Boolean  @default(false) // aparece en home
  active      Boolean  @default(true)
  order       Int      @default(0) // ASC para ordenar
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@index([active, featured])
  @@index([order])
}

/// CRM enrichment por email único. Persiste tags, notas y segmentación
/// independiente de si el cliente tiene CustomerUser (login) o solo
/// CartQuote (lead). Email como PK = clave natural unificada.
model CustomerProfile {
  email     String           @id
  notes     String?          @db.Text
  tags      String[]         @default([])
  segment   CustomerSegment?
  updatedAt DateTime         @updatedAt
  updatedBy String?

  @@index([segment])
}

enum CustomerSegment {
  ENTERPRISE // empresa grande, ticket > 5k habitual
  MIDMARKET // PYME estable
  STARTUP // tiraje pequeño pero recurrente
  ONE_OFF // cliente puntual
  PARTNER // affiliate, embajador
  CHURNED // dejó de comprar (>1 año sin pedido)
}

/// Broadcast email manual — envía a NewsletterSubscriber active. Editor
/// HTML libre o plantilla. Tracking básico (sentCount, failedCount).
/// Programación opcional con scheduledAt — un cron diario procesará los
/// que estén SCHEDULED y haya llegado su hora.
model EmailBroadcast {
  id           String              @id @default(cuid())
  subject      String // asunto del email
  preheader    String? // texto preview en bandeja (Gmail/Outlook)
  html         String              @db.Text
  text         String?             @db.Text // versión texto plano (auto si null)
  audience     BroadcastAudience   @default(NEWSLETTER_ALL)
  // Tags a los que dirigirse cuando audience=NEWSLETTER_TAG.
  // Si se pasan varios, OR (cualquier subscriber con AL MENOS uno de los tags).
  audienceTags String[]            @default([])
  status       BroadcastStatus     @default(DRAFT)
  scheduledAt  DateTime? // si está SCHEDULED, hora de envío
  sentAt       DateTime?
  sentCount    Int                 @default(0)
  failedCount  Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  createdBy    String? // email admin
  deliveries   BroadcastDelivery[]

  @@index([status])
  @@index([scheduledAt])
}

model BroadcastDelivery {
  id          String          @id @default(cuid())
  broadcast   EmailBroadcast  @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  broadcastId String
  email       String
  status      DeliveryAttempt @default(SENT)
  error       String?         @db.Text
  sentAt      DateTime        @default(now())

  @@unique([broadcastId, email])
  @@index([broadcastId])
}

enum BroadcastAudience {
  NEWSLETTER_ALL // todos los subscribers active (no unsubscribed)
  NEWSLETTER_NEW // los últimos 30 días
  NEWSLETTER_TAG // subscribers con tags en EmailBroadcast.audienceTags (OR)
  CUSTOMERS_ALL // todos los CustomerUser con email
  CART_QUOTES_RECENT // emails de CartQuote últimos 90d (lead nurturing)
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELED
}

enum DeliveryAttempt {
  SENT
  FAILED
}

/// Banners promocionales por slot, editables desde admin con ventana de
/// fechas opcional. Solo se muestran al público los que están active=true,
/// dentro de ventana startsAt..endsAt. Si hay varios en el mismo slot,
/// ordenan por priority desc, luego createdAt desc.
model MarketingBanner {
  id        String     @id @default(cuid())
  slot      BannerSlot
  title     String // texto principal grande
  subtitle  String?    @db.Text // texto secundario
  ctaLabel  String? // texto del botón
  ctaUrl    String? // /catalogo, /pay/..., https://..., #ancla
  imageUrl  String? // imagen lateral o de fondo (opcional)
  bgColor   String? // hex ej "#ff6b35" (default = coral del tema)
  textColor String? // hex ej "#faf8f4" (default = bone)
  active    Boolean    @default(true)
  startsAt  DateTime? // null = sin restricción inicio
  endsAt    DateTime? // null = sin restricción fin
  priority  Int        @default(0) // orden dentro del slot (mayor = arriba)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  updatedBy String?

  @@index([slot, active])
  @@index([startsAt])
  @@index([endsAt])
}

enum BannerSlot {
  HOME_TOP // bajo el hero, arriba del marquee
  HOME_MID // entre secciones de la home
  CATALOGO_TOP // dentro del catálogo, arriba de los filtros
  FICHA_PRODUCTO // en la ficha individual de producto
  FOOTER // banda promocional de footer
}

// CMS de marketing — copy editable desde /admin/marketing/site
// Cada setting es un par key/value JSON. Las páginas server-side leen
// los settings al renderizar y caen al fallback hardcoded si no hay valor.
//
// Keys reservadas (convención: dominio.campo):
//   hero.badge       string — texto del pill superior del Hero
//   hero.h1Prefix    string — texto del H1 antes del énfasis coral
//   hero.h1Accent    string — texto en color accent dentro del H1
//   hero.subhead     string — párrafo bajo el H1
//   hero.ctaPrimary  { label, href }
//   hero.ctaSecondary { label, href }
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String? // email del admin que lo cambió
}

// Snapshot del último sync por proveedor
model SupplierSync {
  id               String       @id @default(cuid())
  supplier         SupplierCode @unique
  startedAt        DateTime
  finishedAt       DateTime?
  ok               Boolean      @default(false)
  productsFetched  Int          @default(0)
  productsUpserted Int          @default(0)
  errorsJson       Json?
  notes            String?
}

// ─────────────────────────────────────────────────────────────────────────────
// Promociones — descuentos programables sobre el catálogo.
//
// A diferencia del Coupon (requiere código manual del cliente), una Promotion
// se aplica automáticamente a los productos que entran en su scope durante
// su ventana de validez (startsAt → endsAt). Aparece como precio tachado +
// badge en card y ficha, y se aplica también a todos los PriceTier (no solo
// al fromPriceCents) para que el precio del carrito sea coherente.
//
// Múltiples promos pueden coexistir; se aplica la de mayor descuento por
// producto (no se acumulan). El override de precio del producto se aplica
// PRIMERO, la promo va sobre el resultado.
//
// Scope:
//   ALL          → todo el catálogo
//   CATEGORY     → targetIds = [categoryId, …]
//   BRAND        → targetIds = [brandName, …]  (strings; brand no tiene model)
//   TAG          → targetIds = [marketingTag, …] (matchea ProductOverride.marketingTags)
//   PRODUCT_LIST → targetIds = [productId, …]
//
// Ejemplos:
//   - "Black Friday −20%" scope=ALL, kind=PERCENT, value=20, startsAt/endsAt
//   - "Liquidación textil −5€" scope=CATEGORY, value=500 (cents fijos)
//   - "Best-sellers verano" scope=TAG, targetIds=["best-seller"]
model Promotion {
  id          String  @id @default(cuid())
  name        String // nombre interno, ej. "Black Friday 2026"
  slug        String  @unique // url-friendly, ej. "black-friday-2026"
  description String? @db.Text // contexto interno para el equipo

  kind  PromotionKind // PERCENT (10 = -10%) o FIXED (centavos)
  value Int // valor del descuento (% o cents según kind)

  scope     PromotionScope // dónde aplica
  targetIds String[]       @default([]) // IDs según scope (categoryId / brand / tag / productId)

  startsAt DateTime // empieza a aplicar
  endsAt   DateTime? // termina (null = indefinida)
  active   Boolean   @default(true) // toggle manual para pausar sin tocar fechas

  // Presentación pública
  badgeText     String? // ej. "−20% BLACK FRIDAY". Si null, se genera auto
  badgeColor    String? // hex opcional, ej. "#E63E73". Si null, accent
  displayInList Boolean @default(true) // mostrar en /promociones

  // Métricas (rellenadas en runtime / batch)
  appliedCount Int @default(0) // veces que se aplicó la promo a un cart line
  viewCount    Int @default(0) // impresiones del badge

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // email admin

  @@index([active, startsAt, endsAt])
  @@index([scope])
}

enum PromotionKind {
  PERCENT
  FIXED
}

enum PromotionScope {
  ALL
  CATEGORY
  BRAND
  TAG
  PRODUCT_LIST
}

// Tracking de cada importación masiva de newsletter desde Excel/CSV.
// Permite ver "el batch" (quién, cuándo, cuántas filas, qué tag se aplicó)
// y deshacer un envío fallido borrando solo el batch (DELETE WHERE importBatchId).
model NewsletterImport {
  id           String                 @id @default(cuid())
  filename     String
  importedBy   String // email admin
  tag          String // tag asignado a todos los subscribers del batch
  totalRows    Int                    @default(0)
  insertedRows Int                    @default(0) // emails nuevos creados
  updatedRows  Int                    @default(0) // ya existían, se actualizaron (tag, name…)
  skippedRows  Int                    @default(0) // dedupe, email inválido, ya opt-out
  errorsJson   Json? // hasta 50 errores: { row, email, message }
  createdAt    DateTime               @default(now())
  subscribers  NewsletterSubscriber[]

  @@index([createdAt(sort: Desc)])
  @@index([tag])
}
