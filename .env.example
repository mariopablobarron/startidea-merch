# Postgres (Coolify lo provee)
DATABASE_URL="postgresql://user:pass@host:5432/startidea_merch?schema=public"

# Resend (emails de cotización)
RESEND_API_KEY=""
RESEND_FROM="TodoMerchandising <pedidos@startidea.es>"
RESEND_TO_INTERNAL="mariopablobarron@gmail.com"

# Pública
NEXT_PUBLIC_SITE_URL="https://merchandising.hubstartidea.es"
# Google Analytics 4 + Search Console (opcional, complementa a Umami)
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""
# Pixels publicitarios (env-driven, solo se cargan si están definidos)
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GOOGLE_ADS_ID=""              # formato AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_CONVERSION_LABEL=""    # label conversión Purchase
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=""
NEXT_PUBLIC_LINKEDIN_PURCHASE_CONV_ID=""  # opcional, conversion ID LI
NEXT_PUBLIC_LINKEDIN_LEAD_CONV_ID=""      # opcional, conversion ID LI
# Número WhatsApp con prefijo internacional, sin '+'. Ej: 34600123456
NEXT_PUBLIC_WHATSAPP_NUMBER="34958045789"

# Proveedores (F1 — vacíos en F0)
MIDOCEAN_API_KEY=""
MIDOCEAN_API_BASE="https://api.midocean.com"
MIDOCEAN_CUSTOMER_NUMBER=""

# MIDOCEAN_LIVE_ORDERS=true habilita envío real de POST /orders al gateway.
# Ahora también es alternable desde /admin/suppliers/midocean (AdminSetting
# `midocean_live_orders` sobreescribe este env). Default seguro: simulación.
MIDOCEAN_LIVE_ORDERS="false"

# Cifra Shop — token UUID en path. Rotable desde portal cifra.es.
CIFRA_API_TOKEN=""
CIFRA_API_BASE="https://api.cifrashop.com"
CIFRA_LANG="es"
MAKITO_FEED_USER=""
MAKITO_FEED_PASS=""
MAKITO_FEED_URL=""

# Makito API B2B oficial (apis.makito.es) — cliente JWT con rate limit 100/25min
# El modo activo (sandbox|production) se cambia desde /admin/suppliers/makito
# sin redeploy (se guarda en AdminSetting). NUNCA commitear estos valores.
MAKITO_B2B_BASE="https://apis.makito.es"
MAKITO_B2B_SANDBOX_CLIENT_ID=""
MAKITO_B2B_SANDBOX_CLIENT_SECRET=""
MAKITO_B2B_PROD_CLIENT_ID=""
MAKITO_B2B_PROD_CLIENT_SECRET=""

# Admin / cron secrets (mismo patrón que mentor-web)
ADMIN_SECRET=""
CRON_SECRET=""

# Backup Postgres a Telegram (opcional, usado por /api/cron/backup-db)
# Crea un bot en @BotFather y un grupo privado donde añades el bot.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Chat del equipo para alertas de cotizaciones/pagos (puede ser distinto al de backups)
TELEGRAM_TEAM_CHAT_ID=""

# Recomendador IA (/api/recommend)
# OpenRouter como gateway — permite cambiar de modelo sin tocar código.
# Modelo por defecto: anthropic/claude-sonnet-4.5. Otros recomendados:
#   - anthropic/claude-haiku-4.5 (más barato, latencia menor)
#   - openai/gpt-4o
#   - google/gemini-2.5-pro
OPENROUTER_API_KEY=""
# Modelo por defecto del recomendador público y suggestions dashboard
OPENROUTER_MODEL="anthropic/claude-sonnet-4.5"
# Override solo para el generador de propuestas admin (mayor calidad)
# OPENROUTER_MODEL_PROPOSAL="anthropic/claude-opus-4.7"

# Pedidos MidOcean (sprint 7)
# IMPORTANTE: por defecto el endpoint /api/admin/cart-quotes/[id]/place-order
# SIMULA y NO envía el pedido a MidOcean. Para enviar de verdad setear:
MIDOCEAN_LIVE_ORDERS="false"
MIDOCEAN_CUSTOMER_NUMBER=""

# Margen comercial aplicado en /api/quote/calculate (default 1.6)
MARGIN_MULTIPLIER="1.6"

# Stripe (sprint 8 — pagos online)
# Modo "test" usa keys sk_test_/pk_test_ y NO cobra de verdad. Cuando pruebes
# en producción cambia a "live" y rota a las keys live de Stripe.
STRIPE_MODE="test"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Web Push (sprint 10) — admin recibe notificaciones cuando llega cotización
# Generar VAPID keys con: pnpm dlx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:pedidos@startidea.es"

# Stripe Tax (auto-cálculo IVA por país en Checkout). Activar tras configurar
# tax registrations en Stripe Dashboard para España + UE necesarios.
STRIPE_TAX_ENABLED="false"

# Embeddings para búsqueda semántica. OpenRouter enruta a OpenAI/Cohere/etc.
EMBEDDING_MODEL="openai/text-embedding-3-small"
